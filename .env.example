# ---- Application ----
APP_ENV=development          # development | staging | production
HTTP_ADDR=:8080
LOG_LEVEL=info               # debug | info | warn | error
SHUTDOWN_TIMEOUT=15s

# ---- PostgreSQL ----
# Inside docker compose the host is the service name "postgres".
DATABASE_URL=postgres://vpn:vpn@postgres:5432/vpn?sslmode=disable
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn
POSTGRES_DB=vpn

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO (object storage for QR/configs/backups) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Auth ----
# Generate a strong secret in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Token of the Telegram bot used for Telegram Login signature verification.
TELEGRAM_BOT_TOKEN=
