# ---- Application ----
APP_ENV=development          # development | staging | production
HTTP_ADDR=:8080
LOG_LEVEL=info               # debug | info | warn | error
SHUTDOWN_TIMEOUT=15s

# ---- PostgreSQL ----
# Inside docker compose the host is the service name "postgres".
DATABASE_URL=postgres://vpn:vpn@postgres:5432/vpn?sslmode=disable
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn
POSTGRES_DB=vpn

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO (object storage for QR/configs/backups) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Endpoint as seen from the API container (compose service name).
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=vpn-configs
MINIO_USE_SSL=false

# ---- VPN ----
# 32-byte AES-256 key (64 hex chars) for encrypting stored configs at rest.
# Generate in production: openssl rand -hex 32
VPN_CONFIG_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Node provisioning: noop (store-only, no live node) | agent (call node agent).
PROVISIONER_MODE=noop
PROVISIONER_AGENT_TOKEN=
# Host/IP clients connect to for the seeded dev server (placeholder by default).
SEED_SERVER_HOST=203.0.113.10

# ---- Billing ----
# Externally reachable base URL (used for payment webhook callbacks).
PUBLIC_BASE_URL=http://localhost:8080
# Subscription grace period after expiry before access is revoked.
GRACE_PERIOD=72h
# Cryptomus (crypto payments) — optional; provider enabled only when both are set.
CRYPTOMUS_MERCHANT=
CRYPTOMUS_API_KEY=
# Telegram Stars per USD used to price in-bot invoices (low value for cheap testing).
STARS_PER_USD=1

# ---- Auth ----
# Generate a strong secret in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Token of the Telegram bot used for Telegram Login signature verification.
TELEGRAM_BOT_TOKEN=
