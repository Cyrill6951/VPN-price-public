AGENT_TOKEN={{ agent_token }}
AGENT_ADDR=:{{ agent_port | default(8090) }}
WG_INTERFACE=wg0

# VLESS/Xray client management: the agent edits this config's clients list and
# reloads Xray on add/remove.
XRAY_CONFIG=/opt/vpn-node/xray.json
XRAY_INBOUND_TAG=vless-reality
XRAY_FLOW=xtls-rprx-vision
XRAY_RELOAD_CMD=docker restart vpn-node-xray-1
