# Copy to deploy/ansible/secrets/credentials.env (that path is git-ignored) and
# fill in real values. NEVER commit the real file and NEVER paste it in chat.
#
#   mkdir -p deploy/ansible/secrets
#   cp deploy/ansible/credentials.example.env deploy/ansible/secrets/credentials.env
#   # then edit deploy/ansible/secrets/credentials.env
#
# Preferred: switch to SSH keys and leave the password empty (see README).

VDS_HOST=185.228.72.206
VDS_USER=root
# Used only for the first connection if you have not set up SSH keys yet.
VDS_SSH_PASSWORD=

# Shared secret between the platform and the node agent (generate a strong one):
#   openssl rand -hex 32
AGENT_TOKEN=
